# مفتاح سري لتوقيع الجلسات. غيّره إلزامي قبل أي نشر.
SECRET_KEY=change-me-to-a-long-random-string

# قاعدة البيانات. الافتراضي SQLite في مجلد instance/
# DATABASE_URL=sqlite:///instance/app.db

# ---- الذكاء الاصطناعي (اختياري) ----
# بدون مفتاح يعمل الموقع كاملاً، وتُعطَّل ميزتا AI فقط برسالة واضحة.
# OPENAI_API_KEY=sk-...
AI_MODEL=gpt-6-luna
AI_TIMEOUT=45
AI_MAX_INPUT_CHARS=6000
AI_MAX_OUTPUT_TOKENS=300
AI_MAX_SUGGESTIONS=5

# ---- السجلات ----
LOG_LEVEL=INFO
LOG_TO_STDERR=true
LOG_MAX_BYTES=2097152
LOG_BACKUP_COUNT=5

# ---- دوري روشن السعودي ----
# قسم النتائج والمواعيد في الرئيسية. المصدر ESPN بلا مفتاح، والبيانات تُكاش
# في instance/league.json وتُجدَّد تلقائياً كل LEAGUE_TTL ثانية.
# LEAGUE_ENABLED=1
# LEAGUE_TTL=600
# LEAGUE_TIMEOUT=5
# LEAGUE_CACHE_DIR=

# ---- الخادم ----
HOST=127.0.0.1
PORT=8000
ITEMS_PER_PAGE=13
